{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "out"
      }
    },
    {
      "src": "api/visitors.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/visitors/?",
      "dest": "/api/visitors.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
